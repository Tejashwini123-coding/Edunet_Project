# ─────────────────────────────────────────────────────────────────
#  LearnMate – Environment Variables
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# IBM Cloud API Key (create at https://cloud.ibm.com/iam/apikeys)
IBM_API_KEY=3A6r1aLOmf22Rqs19ybY5aBROrUyh9g_2dsU5hyPpOXs

# IBM watsonx.ai Project ID (found in your watsonx.ai project settings)
WATSONX_PROJECT_ID=22af5815-51be-42e2-bd98-0efaf8a04362

# IBM watsonx.ai API endpoint (default is Dallas region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use (options below)
#   ibm/granite-13b-instruct-v2
#   ibm/granite-3-8b-instruct   ← recommended
#   ibm/granite-20b-multilingual
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Flask secret key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_secret_key

# Flask environment (development | production)
FLASK_ENV=development

# Session storage directory (relative to app root)
SESSION_FILE_DIR=./flask_session
